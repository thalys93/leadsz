# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

# ── Server ────────────────────────────────────
PORT=3003
NODE_ENV=development
# development | production (espelha VITE_APP_ENV do frontend)
APP_ENV=development
API_VERSION=v0
FRONTEND_URL=http://localhost:5173

# ── Branding ──────────────────────────────────
APP_NAME=LeadsZ
API_TITLE=LeadsZ API
SWAGGER_DESCRIPTION=API documentation for LeadsZ
APP_ICON_URL=https://res.cloudinary.com/dh39ahmpj/image/upload/v1785066171/app-icon_krffrs.png
APP_WORDMARK_URL=https://res.cloudinary.com/dh39ahmpj/image/upload/v1785066171/workdmark_nf2gw9.png

# ── Feature Flags ─────────────────────────────
FEATURE_SEEDING=true

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=leadsz

# ── Deploy / CORS ─────────────────────────────
APP_PUBLIC_URL=https://leadz-api.thalysdev.com
CORS_ORIGIN=http://localhost:5173,https://leadz.thalysdev.com,https://thalysdev.com,https://www.thalysdev.com

# ── Groq (geração de templates) ───────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── JWT ───────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── Mail ──────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_SUPPORT_EMAIL=

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
